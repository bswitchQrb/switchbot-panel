# SwitchBot アプリ → プロフィール → 設定 → 基本データ → 「アプリバージョン」を 10 回タップ
# → 開発者向けオプションに表示されるトークンとクライアントシークレット
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# 待ち受けるアドレス。既定はこの PC からのみ（127.0.0.1）
# 他の端末から使うなら Tailscale などの VPN の IP を指定するのがおすすめ
# 0.0.0.0 にすると同じネットワークの誰でも操作できるので注意
HOST=127.0.0.1
PORT=8787

# HOST 以外の名前（Tailscale の MagicDNS 名など）でも開く場合は、カンマ区切りで指定
# ALLOWED_HOSTS=my-pc.tailnet-name.ts.net,my-pc

# 1 にするとスマートロックの解錠を無効化（施錠のみ可能）
DISABLE_UNLOCK=0
